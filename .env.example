DATABASE_URL=postgres://qist:qist_dev_password@localhost:5434/qist

# Direct (non-pooled) connection used by migrations when DATABASE_URL points at a pooler (Neon sets this).
# DATABASE_URL_UNPOOLED=
# Connections per server instance (default 10, 3 on Vercel).
# DATABASE_POOL_MAX=

# Uploaded customer documents: "disk" (default, under STORAGE_DIR) or "database" (hosts without a persistent disk, e.g. Vercel).
# STORAGE_DRIVER=database
# STORAGE_DIR=/var/lib/qist/storage
# Upload limit in MB (default 10). Vercel caps request bodies at 4.5 MB, so use 4 there.
# NEXT_PUBLIC_MAX_DOCUMENT_MB=4

# Seed admin (used by `npm run db:seed`). Change the password after first login.
SEED_ADMIN_NAME=مدير النظام
SEED_ADMIN_EMAIL=admin@qist.local
SEED_ADMIN_PASSWORD=
